{
  "name": "custom-fumadocs-static",
  "version": "1.0.0",
  "private": true,
  "description": "Fumadocs custom documentation site with static export",
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "build:docs": "pnpm --filter custom-docs build",
    "dev": "pnpm --filter custom-docs dev",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "tsup": "8.5.0",
    "turbo": "2.6.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">= 18.17.0"
  }
}
